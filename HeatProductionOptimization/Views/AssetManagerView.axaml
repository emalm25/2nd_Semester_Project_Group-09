<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HeatProductionOptimization.ViewModels"
    x:DataType="vm:AssetManagerViewModel"
    x:Class="HeatProductionOptimization.Views.AssetManagerView">

    <StackPanel>
        <TextBlock Text="Asset manager information" Margin="18" FontSize="22" FontWeight="SemiBold"/>
        <ScrollViewer Classes="asset-scroll" AllowAutoHide="True" HorizontalScrollBarVisibility="Visible" VerticalAlignment="Top" Padding="0">
            <!-- Custom styles for the scrollbar -->
            <ScrollViewer.Styles>
                <Style Selector="ScrollViewer.asset-scroll ScrollBar /template/ Thumb">
                    <Setter Property="Background" Value="#d94545"/>
                </Style>

                <Style Selector="ScrollViewer.asset-scroll ScrollBar /template/ Rectangle#TrackRect">
                    <Setter Property="Fill" Value="#2E2E2E"/>
                    <Setter Property="Opacity" Value="0"/>
                </Style>
            </ScrollViewer.Styles>

            <ItemsControl ItemsSource="{Binding Units}" Margin="20,20,20,36">
                <!-- Define layout: horizontal with spacing -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="20"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <!-- Define template for each unit -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                        <Border Background="#2E2E2E" BorderThickness="2" BorderBrush="#d94545" CornerRadius="5" Height="520" Width="260" Padding="15" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <!-- Image -->
                                <Border BorderThickness="10" CornerRadius="3" Background="#d94545" HorizontalAlignment="Center">
                                    <Image Source="{Binding Image}" Width="150" Height="138" Stretch="Uniform"/>
                                </Border>
                                
                                <!-- Unit Header -->
                                <Border BorderThickness="0,0,0,2" BorderBrush="#d94545" Padding="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="{Binding ShortName}" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAvailable, Mode=TwoWay}" OnContent="" OffContent="" HorizontalAlignment="Right">
                                        <!-- Custom styles for the switch -->
                                        <ToggleSwitch.Styles>
                                            <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
                                                <Setter Property="Background" Value="#d94545"/>
                                            </Style>
                                            <Style Selector="ToggleSwitch:unchecked /template/ Border#OuterBorder">
                                                <Setter Property="Background" Value="#252525"/>
                                                <Setter Property="BorderBrush" Value="#252525"/>
                                            </Style>
                                        </ToggleSwitch.Styles>
                                    </ToggleSwitch>
                                </Grid>
                                </Border>
                                
                                <!-- Data Fields -->
                                <StackPanel Spacing="10">
                                    <!-- Max Heat -->
                                    <StackPanel>
                                        <TextBlock Text="Max Heat:" FontSize="12" Padding="0,0,0,3"/>
                                        <TextBlock Text="{Binding MaxHeat, StringFormat={}{0:F1} MW}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <!-- Max Electricity (if available) -->
                                    <StackPanel IsVisible="{Binding MaxElectricity, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="Max Electricity:" FontSize="12" Padding="0,0,0,3"/>
                                        <TextBlock Text="{Binding MaxElectricity, StringFormat={}{0:F1} MW}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <!-- Production Costs -->
                                    <StackPanel>
                                        <TextBlock Text="Production Costs:" FontSize="12" Padding="0,0,0,3"/>
                                        <TextBlock Text="{Binding ProductionCosts, StringFormat={}{0} DKK / MWh(th)}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- CO2 Emissions -->
                                    <StackPanel>
                                        <TextBlock Text="CO₂ Emissions:" FontSize="12" Padding="0,0,0,3"/>
                                        <TextBlock Text="{Binding CO2Emissions, StringFormat={}{0} kg / MWh(th), TargetNullValue=None}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <!-- Gas Consumption (if available) -->
                                    <StackPanel IsVisible="{Binding GasConsumption, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="Gas Consumption:" FontSize="12" Padding="0,0,0,3"/>
                                        <TextBlock Text="{Binding GasConsumption, StringFormat={}{0:F2} MWh(gas) / MWh(th)}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <!-- Oil Consumption (if available) -->
                                    <StackPanel IsVisible="{Binding OilConsumption, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="Oil Consumption:" FontSize="12" Padding="0,0,0,3"/>
                                        <TextBlock Text="{Binding OilConsumption, StringFormat={}{0:F2} MWh(oil) / MWh(th)}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <!-- Gas Motor Consumption (if available) -->
                                    <StackPanel IsVisible="{Binding Gas2Consumption, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="Gas Consumption:" FontSize="12" Padding="0,0,0,3"/>
                                        <TextBlock Text="{Binding Gas2Consumption, StringFormat={}{0:F2} MWh(gas) / MWh(th)}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>

</UserControl>