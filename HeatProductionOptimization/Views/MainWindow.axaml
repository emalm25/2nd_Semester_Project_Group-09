<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeatProductionOptimization.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HeatProductionOptimization.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Danfoss-logo.ico"
        Title="Welcome to our heat production optimizer">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- styles for tabs -->
    <Window.Styles>
        <Styles>
            <!-- make each tab header a white rectangle with black text and border -->
            <Style Selector="TabItem">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="BorderBrush" Value="Black"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>
            <!-- optional: adjust TabControl chrome if needed -->
            <Style Selector="TabControl">
                <Setter Property="TabStripPlacement" Value="Top"/>
            </Style>
        </Styles>
    </Window.Styles>

    <!-- main window content replaced with tabs for each manager -->
    <TabControl>

        <TabItem Header="Welcome" IsSelected="True">
            <TextBlock Text="Welcome to our heat production optimizer!" Margin="10" FontSize="18" Foreground="White"/>
        </TabItem>

        <TabItem Header="Asset manager">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AssetManager.Units}" Margin="20">
                    <!-- Define layout: horizontal with spacing -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="20"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <!-- Define template for each unit -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Width="260" Height="425" Padding="15" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <!-- Image -->
                                    <Border Height="120" CornerRadius="3" Background="LightGray" ClipToBounds="True">
                                        <Image Source="{Binding Image}" Stretch="Uniform"/>
                                    </Border>
                                    
                                    <!-- Unit Header -->
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding ShortName}" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                    </StackPanel>
                                    
                                    <!-- Data Fields -->
                                    <StackPanel Spacing="6">
                                        <!-- Max Heat -->
                                        <StackPanel>
                                            <TextBlock Text="Max Heat" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding MaxHeat}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        
                                        <!-- Max Electricity (if available) -->
                                        <StackPanel IsVisible="{Binding MaxElectricity, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Max Electricity" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding MaxElectricity}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        
                                        <!-- CO2 Emissions -->
                                        <StackPanel>
                                            <TextBlock Text="CO₂ Emissions" FontSize="12" Foreground="Gray"/>
                                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}">
                                                        <Binding Path="CO2Emissions" FallbackValue="N/A"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Production Costs -->
                                        <StackPanel>
                                            <TextBlock Text="Production Costs" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding ProductionCosts}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        
                                        <!-- Gas Consumption (if available) -->
                                        <StackPanel IsVisible="{Binding GasConsumption, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Gas Consumption" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding GasConsumption}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        
                                        <!-- Oil Consumption (if available) -->
                                        <StackPanel IsVisible="{Binding OilConsumption, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Oil Consumption" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding OilConsumption}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        
                                        <!-- Gas Motor Consumption (if available) -->
                                        <StackPanel IsVisible="{Binding Gas2Consumption, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Gas Consumption" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding Gas2Consumption}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Source Data Manager">
            <TextBlock Text="Source data manager information" Margin="10"/>
        </TabItem>

        <TabItem Header="Result Data Manager">
            <TextBlock Text="Result data manager information" Margin="10"/>
        </TabItem>

        <TabItem Header="Optimizer">
            <TextBlock Text="Optimize data here" Margin="10"/>
        </TabItem>

        <TabItem Header="Data Visualization">
            <TextBlock Text="Visualize data here" Margin="10"/>
        </TabItem>

    </TabControl>

</Window>

