<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeatProductionOptimization.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:HeatProductionOptimization.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HeatProductionOptimization.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Danfoss-logo.ico"
        Title="Welcome to our heat production optimizer"
        Background="#252525"
        Foreground="White">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Styles>
            <Style Selector="TabItem">
                <Setter Property="Background" Value="#d94545"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="Black"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>
            <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
			    <Setter Property="Background" Value="#d94545"/>
		    </Style>
            <Style Selector="TabItem:selected">
			    <Setter Property="Foreground" Value="#d94545"/>
		    </Style>
            <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			    <Setter Property="Foreground" Value="#d94545"/>
		    </Style>
            <Style Selector="TabControl">
                <Setter Property="TabStripPlacement" Value="Top"/>
            </Style>
        </Styles>
    </Window.Styles>

    <TabControl>

        <TabItem Header="Welcome" IsSelected="True">
            <views:WelcomeView/>
        </TabItem>

        <TabItem Header="Asset Manager">
            <views:AssetManagerView DataContext="{Binding AssetManagerViewModel}"/>
        </TabItem>

        <TabItem Header="Source Data Manager">
            <views:SourceDataView/>
        </TabItem>

        <TabItem Header="Result Data Manager">
            <views:ResultDataManagerView DataContext="{Binding ResultDataManagerVM}" />
        </TabItem>

        <TabItem Header="Optimizer">
            <views:OptimizerView DataContext="{Binding OptimizerVM}"/>
        </TabItem>

    </TabControl>

</Window>

