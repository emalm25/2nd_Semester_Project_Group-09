<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:HeatProductionOptimization.ViewModels"
	x:Class="HeatProductionOptimization.Views.OptimizerView"
	x:DataType="vm:MainWindowViewModel">

	<UserControl.Styles>
		<Styles>
			<Style Selector="Button.option">
				<Setter Property="Background" Value="#3A3A3A"/>
				<Setter Property="Foreground" Value="White"/>
				<Setter Property="BorderBrush" Value="#5A5A5A"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Padding" Value="14,8"/>
				<Setter Property="MinWidth" Value="120"/>
			</Style>
			<Style Selector="Button.option.selected">
				<Setter Property="Background" Value="#d94545"/>
				<Setter Property="BorderBrush" Value="#f27474"/>
			</Style>
			<Style Selector="Button.primaryAction">
				<Setter Property="Background" Value="#d94545"/>
				<Setter Property="Foreground" Value="White"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="Padding" Value="22,12"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="MinWidth" Value="180"/>
			</Style>
		</Styles>
	</UserControl.Styles>

	<ScrollViewer>
		<StackPanel Margin="18" Spacing="14">
			<TextBlock Text="Optimization Criteria" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
			<TextBlock Text="Select one option in each category, then run the optimizer." Foreground="#D0D0D0"/>

			<Border Background="#2E2E2E" CornerRadius="8" Padding="14" BorderBrush="#3D3D3D" BorderThickness="1">
				<StackPanel Spacing="12">
					<TextBlock Text="Objective" FontSize="16" FontWeight="SemiBold"/>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Cost" Classes="option" Classes.selected="{Binding IsCostSelected}" Command="{Binding SetObjectiveCommand}" CommandParameter="Cost"/>
						<Button Content="CO2" Classes="option" Classes.selected="{Binding IsCo2Selected}" Command="{Binding SetObjectiveCommand}" CommandParameter="CO2"/>
					</StackPanel>

					<TextBlock Text="Season" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Winter" Classes="option" Classes.selected="{Binding IsWinterSelected}" Command="{Binding SetSeasonCommand}" CommandParameter="Winter"/>
						<Button Content="Summer" Classes="option" Classes.selected="{Binding IsSummerSelected}" Command="{Binding SetSeasonCommand}" CommandParameter="Summer"/>
					</StackPanel>

					<TextBlock Text="Scenario" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Scenario 1" Classes="option" Classes.selected="{Binding IsScenario1Selected}" Command="{Binding SetScenarioCommand}" CommandParameter="Scenario 1"/>
						<Button Content="Scenario 2" Classes="option" Classes.selected="{Binding IsScenario2Selected}" Command="{Binding SetScenarioCommand}" CommandParameter="Scenario 2"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<TextBlock Text="{Binding OptimizationSummary}" Foreground="#E2E2E2" FontStyle="Italic"/>

			<Button Content="Optimize" Classes="primaryAction" HorizontalAlignment="Left" Command="{Binding OptimizeCommand}"/>

			<Border Background="#1F1F1F" CornerRadius="6" BorderBrush="#303030" BorderThickness="1" Padding="10">
				<TextBlock Text="{Binding LastOptimizationMessage}" Foreground="#BFBFBF"/>
			</Border>
		</StackPanel>
	</ScrollViewer>

</UserControl>
