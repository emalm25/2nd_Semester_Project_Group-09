<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HeatProductionOptimization.ViewModels"
    x:Class="HeatProductionOptimization.Views.ResultDataManagerView"
    x:DataType="vm:ResultDataManagerViewModel">

    <UserControl.Styles>
        <Styles>
            <Style Selector="ListBox">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

         
            <Style Selector="ListBoxItem">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Background" Value="#2E2E2E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </Style>

           
            <Style Selector="ListBoxItem:pointerover /template/ Border">
                <Setter Property="Background" Value="#b83b3b"/>
            </Style>
            <Style Selector="ListBoxItem:pointerover TextBlock">
                <Setter Property="Foreground" Value="White"/>
            </Style>

           
            <Style Selector="ListBoxItem:selected Border">
                <Setter Property="Background" Value="#d94545"/>
                <Setter Property="BorderBrush" Value="#d94545"/>
            </Style>
            <Style Selector="Border.selected TextBlock">
                <Setter Property="Foreground" Value="White"/>
            </Style>

        </Styles>
    </UserControl.Styles>


    <ScrollViewer Classes="results-scroll">
        <ScrollViewer.Styles>
            <!-- Style override for ScrollViewer -->
            <Style Selector="ScrollViewer.results-scroll ScrollBar /template/ Thumb">
                <Setter Property="Background" Value="#d94545"/>
            </Style>
            <Style Selector="ScrollViewer.results-scroll ScrollBar /template/ Rectangle#TrackRect">
                <Setter Property="Fill" Value="#2E2E2E"/>
                <Setter Property="Opacity" Value="0"/>
            </Style>
        </ScrollViewer.Styles>


        <StackPanel Margin="20" Spacing="10">
            <TextBlock Text="Result Manager" FontSize="22" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Save" Command="{Binding SaveCommand}" Background="#d94545" Foreground="White"/>
                <Button Content="Load" Command="{Binding LoadCommand}" Background="#d94545" Foreground="White"/>
                <Button Content="Remove selected" Command="{Binding RemoveSelectedCommand}" Background="#d94545" Foreground="White"/>
                <Button Content="Remove all" Command="{Binding ClearAllCommand}" Background="#d94545" Foreground="White"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" />

            <ListBox Classes="listbox" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes.selected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Padding="6">
                            <StackPanel Spacing="32" Orientation="Horizontal">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Minimalize, StringFormat='Minimalize: {0}'}"/>
                                    <TextBlock Text="{Binding Season, StringFormat='Season: {0}'}"/>
                                    <TextBlock Text="{Binding MaintenanceUnit, StringFormat='Maintenance: {0}'}"/>
                                    <TextBlock Text="{Binding Scenario, StringFormat='Scenario: {0}'}"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding HeatProduction, StringFormat='Heat production: {0:F2} MWh'}"/>
                                    <TextBlock Text="{Binding ElectricityProduction, StringFormat='Electricity production: {0:F2} MWh'}"/>
                                    <TextBlock Text="{Binding ElectricityConsumption, StringFormat='Electricity consumption: {0:F2} MWh'}"/>
                                    <TextBlock Text="{Binding PrimaryEnergyConsumption, StringFormat='Primary energy consumption: {0:F2} MWh'}"/>
                                    <TextBlock Text="{Binding CO2Emissions, StringFormat='CO₂ emissions: {0:F1} kg'}"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Expenses, StringFormat='Expenses: {0:F2} DKK'}"/>
                                    <TextBlock Text="{Binding Profit, StringFormat='Profit: {0:F2} DKK'}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>