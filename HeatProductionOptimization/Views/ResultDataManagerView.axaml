<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HeatProductionOptimization.ViewModels"
    x:Class="HeatProductionOptimization.Views.ResultDataManagerView"
    x:DataType="vm:ResultDataManagerViewModel">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">
            <TextBlock Text="Result Manager" FontSize="22" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <Button Content="Load" Command="{Binding LoadCommand}" />
            <Button Content="Remove selected" Command="{Binding RemoveSelectedCommand}"/>
            <Button Content="Clear all" Command="{Binding ClearAllCommand}"/>
        </StackPanel>  
        <TextBlock Text="{Binding StatusMessage}" />
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel Spacing="4">
                <TextBlock Text="{Binding Minimalize, StringFormat='Minimalize: {0}'}"/>
                <TextBlock Text="{Binding Season, StringFormat='Season: {0}'}"/>
                <TextBlock Text="{Binding Scenario, StringFormat='Scenario: {0}'}"/>
                <TextBlock Text="{Binding HeatProduction, StringFormat='Heat production: {0}'}"/>
                <TextBlock Text="{Binding ElectricityProduction, StringFormat='Electricity production: {0}'}"/>
                <TextBlock Text="{Binding ElectricityConsumption, StringFormat='Electricity consumption: {0}'}"/>
                <TextBlock Text="{Binding Expenses, StringFormat='Expenses: {0}'}"/>
                <TextBlock Text="{Binding Profit, StringFormat='Profit: {0}'}"/>
                <TextBlock Text="{Binding PrimaryEnergyConsumption, StringFormat='Primary energy consumption: {0}'}"/>
                <TextBlock Text="{Binding CO2Emissions, StringFormat='CO2 emissions: {0}'}"/>

</StackPanel>
</Border>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</StackPanel>
</ScrollViewer>
</UserControl>