<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HeatProductionOptimization.ViewModels"
    x:Class="HeatProductionOptimization.Views.SourceDataView"
    x:DataType="vm:SourceDataViewModel">


   <UserControl.Styles>
    <Styles>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#d94545"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>


        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3f3f3f"/>
        </Style>

       
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#555555"/>
        </Style>

    
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="#d94545"/>
        </Style>

    </Styles>
</UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,*">

